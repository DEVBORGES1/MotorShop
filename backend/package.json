{
  "name": "@motorshop/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "build": "node --env-file-if-exists=../.env --input-type=module -e \"await import('./src/app.js'); console.log('backend: verificação de build OK');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file-if-exists=../.env src/scripts/seed.js",
    "db:indexes": "node --env-file-if-exists=../.env src/scripts/createIndexes.js",
    "create:superadmin": "node --env-file-if-exists=../.env src/scripts/createSuperAdmin.js"
  },
  "dependencies": {
    "@motorshop/shared": "*",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "slugify": "^1.6.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
