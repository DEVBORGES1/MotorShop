# =============================================================================
# MotorShop — variáveis de ambiente
#
# Copie para `.env` na RAIZ do projeto e preencha os valores.
# Este arquivo serve o BACKEND (carregado com `node --env-file-if-exists`).
#
# O frontend tem o seu próprio arquivo: `frontend/.env.example`. A separação é
# proposital — ver docs/SETUP.md.
#
# NUNCA versione o `.env`. NUNCA coloque valores reais neste exemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development          # development | test | production
PORT=3000

# -----------------------------------------------------------------------------
# CORS — origem do frontend.
# Aceita múltiplas origens separadas por vírgula. Nunca use "*".
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Banco de dados — MongoDB Atlas
#
# Opcional em desenvolvimento: sem ela a API sobe normalmente e o health check
# reporta `database.status: not_configured`. OBRIGATÓRIA em produção.
#
# Use um usuário com permissão restrita a UM database (nunca atlasAdmin) e
# databases distintos por ambiente (_dev, _staging, _prod).
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Autenticação
#
# Mínimo de 32 caracteres, DIFERENTE por ambiente. Obrigatório em produção.
# Fora de produção, se ausente, um segredo temporário é gerado no boot — as
# sessões administrativas então não sobrevivem a um reinício do servidor.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# Imagens das motos (ARCHITECTURE §10)
#
# O navegador envia as fotos DIRETO ao provedor, com assinatura emitida pela
# API — o arquivo nunca passa pelo backend. Sem provedor (`none`), o site
# funciona e só o envio de fotos no painel fica indisponível.
#
# Cloudinary: Dashboard → "Product Environment Credentials". O API secret é
# SEGREDO: só aqui, nunca no frontend.
# STORAGE_FOLDER separa lojas e ambientes na mesma conta (ex.: loja-x/prod).
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=none         # none | cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_FOLDER=motorshop

# -----------------------------------------------------------------------------
# Observabilidade e limites
# -----------------------------------------------------------------------------
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
BODY_LIMIT=100kb              # limite do corpo JSON (imagens não passam pela API)

# -----------------------------------------------------------------------------
# SEO e site público (ARCHITECTURE §11 e §13.2)
#
# Em produção este processo também serve o site (frontend/dist) com título,
# descrição e preview de link já no HTML. ROBOTS_POLICY=disallow em staging e
# demonstração, para não competir com o site real no Google.
# -----------------------------------------------------------------------------
ROBOTS_POLICY=allow           # allow | disallow

# -----------------------------------------------------------------------------
# Proxies à frente da API (CDN, balanceador) — define de onde vem o IP real
# do visitante, base de todo limite por IP. Precisa bater com o deploy:
#   0 = acesso direto · 1 = só a plataforma (ex.: Render) · 2 = Cloudflare → Render
# A mais: o visitante forja o próprio IP e contorna os limites.
# A menos: todos aparecem com o IP do proxy e se bloqueiam entre si.
# -----------------------------------------------------------------------------
TRUST_PROXY_HOPS=1
FRONTEND_DIST_DIR=            # vazio = frontend/dist do monorepo

