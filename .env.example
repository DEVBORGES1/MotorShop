# =============================================================================
# MotorShop — exemplo de variáveis de ambiente
#
# Copie para `.env` e preencha com valores reais.
# NUNCA versione o arquivo `.env`. NUNCA coloque valores reais aqui.
#
# Definido na FASE 0. Os valores passam a ser efetivamente consumidos a partir
# da FASE 1, quando `backend/src/config/env.js` valida tudo com Zod no boot —
# o servidor recusa iniciar se algo obrigatório faltar ou for inválido.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development          # development | staging | production
PORT=4000
APP_URL=http://localhost:5173 # URL pública do site (canonical, OG, sitemap)

# -----------------------------------------------------------------------------
# Banco de dados — MongoDB Atlas
# Use um usuário com permissão restrita a UM database (nunca atlasAdmin).
# Use databases distintos por ambiente: _dev, _staging, _prod.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/motorshop_dev?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Autenticação
# JWT_SECRET: mínimo 32 bytes aleatórios, DIFERENTE por ambiente.
#   Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=motorshop
JWT_AUDIENCE=motorshop-admin

# -----------------------------------------------------------------------------
# CORS — lista separada por vírgula. Nunca use "*".
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Armazenamento de imagens
# STORAGE_PROVIDER seleciona o driver por trás da porta de armazenamento.
# Valor no MVP: cloudinary. Futuro: r2 | s3.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=motorshop/dev   # pasta por ambiente: dev | staging | prod

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_LEVEL=debug               # debug | info | warn | error

# -----------------------------------------------------------------------------
# Frontend (Vite)
# ATENÇÃO: tudo com prefixo VITE_ vai para o bundle e é PÚBLICO.
# Nunca coloque segredo aqui.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
