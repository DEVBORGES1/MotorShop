# =============================================================================
# MotorShop — variáveis de ambiente
#
# Copie para `.env` na RAIZ do projeto e preencha os valores.
# Este arquivo serve o BACKEND (carregado com `node --env-file-if-exists`).
#
# O frontend tem o seu próprio arquivo: `frontend/.env.example`. A separação é
# proposital — ver docs/SETUP.md.
#
# NUNCA versione o `.env`. NUNCA coloque valores reais neste exemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development          # development | test | production
PORT=3000

# -----------------------------------------------------------------------------
# CORS — origem do frontend.
# Aceita múltiplas origens separadas por vírgula. Nunca use "*".
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Banco de dados — MongoDB Atlas
#
# Opcional em desenvolvimento: sem ela a API sobe normalmente e o health check
# reporta `database.status: not_configured`. OBRIGATÓRIA em produção.
#
# Use um usuário com permissão restrita a UM database (nunca atlasAdmin) e
# databases distintos por ambiente (_dev, _staging, _prod).
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Autenticação (utilizado a partir da FASE 3)
#
# Mínimo de 32 caracteres, DIFERENTE por ambiente. Obrigatório em produção.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# Observabilidade e limites
# -----------------------------------------------------------------------------
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
BODY_LIMIT=100kb              # limite do corpo JSON (imagens não passam pela API)

